{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go mod tidy:*)",
      "Bash(go mod download:*)",
      "Bash(go list:*)",
      "Bash(go tool cover:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",
      "Bash(./bin/brd:*)",
      "Bash(./brd:*)",
      "Bash(npm --prefix web install)",
      "Bash(npm --prefix web ci)",
      "Bash(npm --prefix web run build)",
      "Bash(npm --prefix web run dev)",
      "Bash(npm --prefix web run lint)",
      "Bash(npm --prefix web run type-check)",
      "Bash(npm --prefix web run validate)",
      "Bash(npm --prefix web run format)",
      "Bash(npm --prefix web run format:check)",
      "Bash(npm --prefix web run test:run)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite:*)",
      "Bash(npx @tanstack/router-cli generate)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(test:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(tar:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git describe:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo view:*)",
      "Bash(docker build:*)",
      "Bash(docker images:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:golangci-lint.run)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(gh pr create:*)",
      "Bash(gh workflow run:*)",
      "Bash(docker push:*)",
      "Bash(docker run:*)"
    ],
    "deny": [
      "Read(./config.yml)",
      "Read(./bared.yml)",
      "Read(./*.local.yml)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-save.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-stop.sh"
          }
        ]
      }
    ]
  }
}
