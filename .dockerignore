# Git files
.git
.gitignore
.github

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Claude files
.claude

# Build artifacts
bin/
dist/
*.exe
*.dll
*.so
*.dylib

# Test and coverage files
coverage.out
coverage.html
*.test

# Backup directories
backups/

# Documentation (except README.md which is used by Docker Hub)
*.md
!README.md
docs/

# Configuration files (examples will be in image, but not user configs)
config.yml
restore-config.local.yml
bared.yml

# Compose files
compose.yml
docker-compose.yml

# Web frontend intermediate files
apps/web/node_modules
apps/web/dist
apps/web/.vite
apps/web/.eslintcache
apps/web/coverage

# Locally-built embed target — the image rebuilds it from the frontend stage,
# so shipping the host's copy in would only risk stale assets.
apps/api/internal/web/dist

# Database files
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/

# Go module cache
vendor/

# Development and planning files
plan.md
TESTING_PLAN.md
TOOLING.md
IMPLEMENTATION_COMPLETE.md
CONTRIBUTING.md
DEVELOPMENT.md
