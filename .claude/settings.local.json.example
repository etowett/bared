{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go mod tidy:*)",
      "Bash(go mod download:*)",
      "Bash(go list:*)",
      "Bash(go tool cover:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",
      "Bash(./bin/brd:*)",
      "Bash(./brd:*)",
      "Bash(bun install --cwd apps/web)",
      "Bash(bun install --frozen-lockfile --cwd apps/web)",
      "Bash(bun run --cwd apps/web build)",
      "Bash(bun run --cwd apps/web dev)",
      "Bash(bun run --cwd apps/web lint)",
      "Bash(bun run --cwd apps/web lint:fix)",
      "Bash(bun run --cwd apps/web type-check)",
      "Bash(bun run --cwd apps/web validate)",
      "Bash(bun run --cwd apps/web format)",
      "Bash(bun run --cwd apps/web format:check)",
      "Bash(bun run --cwd apps/web test:run)",
      "Bash(bun run --cwd apps/web test:coverage)",
      "Bash(bun --version)",
      "Bash(bunx prettier:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx vite:*)",
      "Bash(bunx @tanstack/router-cli generate)",
      "Bash(./scripts/agents-doctor.py:*)",
      "Bash(python3 scripts/agents-doctor.py:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(test:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(tar:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git describe:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo view:*)",
      "Bash(docker build:*)",
      "Bash(docker images:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:golangci-lint.run)"
    ]
  }
}
