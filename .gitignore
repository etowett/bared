# Binaries
bin/
bared
/brd
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt

# Go workspace file
go.work

# Dependency directories
vendor/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Configuration files with secrets.
# These patterns are unanchored on purpose — a live config must not slip in at
# any depth. The one exception is GitHub's issue-template chooser, whose filename
# is fixed by GitHub and which holds no secrets.
bared.yml
config.yml
*.local.yml
!.github/ISSUE_TEMPLATE/config.yml

# Backup data (for testing)
/backups/
/tmp/

# Log files
*.log
logs/

# Tracker files (generated at runtime)
.bared/

# Environment files
.env
.env.local
.env.*.local

# Build artifacts
dist/
build/

# Temporary files
tmp/
temp/

# Database files
*.db
*.sqlite3
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-trace
*.sqlite-trace-journal
*.sqlite-trace-wal
*.sqlite-trace-shm

# Agent tooling. Shared config is tracked (see .claude/AGENTS.md for the sync map);
# personal overrides and per-client session state are not.
#
# Claude Code — canonical
.claude/settings.local.json
.claude/*.local.json
.claude/local/

# Codex CLI — mirrors .claude/. Codex writes a lot of local state into .codex/,
# so ignore the directory and re-include only what's shared.
.codex/*
!.codex/AGENTS.md
!.codex/config.toml
!.codex/agents/
!.codex/rules/

.crush/
